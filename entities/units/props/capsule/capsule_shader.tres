[resource]
code = "shader_type canvas_item;
uniform float Speed = 10;
uniform sampler2D TextureUniform2;
uniform sampler2D TextureUniform;



void vertex() {
// Output:0

}

void fragment() {
// Input:3
	vec3 n_out3p0 = COLOR.rgb;

// Input:17
	vec3 n_out17p0 = vec3(UV, 0.0);

// Input:9
	float n_out9p0 = TIME;

// ScalarUniform:13
	float n_out13p0 = Speed;

// ScalarOp:12
	float n_out12p0 = n_out9p0 * n_out13p0;

// VectorOp:16
	vec3 n_out16p0 = n_out17p0 + vec3(n_out12p0);

// VectorOp:18
	vec3 n_in18p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out18p0 = mod(n_out16p0, n_in18p1);

// TextureUniform:14
	vec3 n_out14p0;
	float n_out14p1;
	{
		vec4 n_tex_read = texture(TextureUniform2, n_out18p0.xy);
		n_out14p0 = n_tex_read.rgb;
		n_out14p1 = n_tex_read.a;
	}

// TextureUniform:6
	vec3 n_out6p0;
	float n_out6p1;
	{
		vec4 n_tex_read = texture(TextureUniform, UV.xy);
		n_out6p0 = n_tex_read.rgb;
		n_out6p1 = n_tex_read.a;
	}

// ScalarFunc:8
	float n_out8p0 = sin(n_out12p0);

// ScalarOp:10
	float n_in10p1 = 0.50000;
	float n_out10p0 = n_out8p0 * n_in10p1;

// ScalarOp:11
	float n_in11p1 = 1.00000;
	float n_out11p0 = n_out10p0 + n_in11p1;

// ScalarOp:7
	float n_out7p0 = dot(n_out6p0, vec3(0.333333, 0.333333, 0.333333)) * n_out11p0;

// ScalarOp:15
	float n_out15p0 = dot(n_out14p0, vec3(0.333333, 0.333333, 0.333333)) * n_out7p0;

// Output:0
	COLOR.rgb = n_out3p0;
	COLOR.a = n_out15p0;

}

void light() {
// Output:0

}
