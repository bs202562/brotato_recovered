[resource]
code = "shader_type canvas_item;
uniform float wave_speed = 1;
uniform float wave_size = 1;
uniform sampler2D tex_frg_4;
uniform float wave_strenght = 0.1;
uniform sampler2D TextureUniform;



void vertex() {
// Output:0

}

void fragment() {
// Input:16
	vec3 n_out16p0 = MODULATE.rgb;

// Input:2
	vec3 n_out2p0 = vec3(UV, 0.0);

// Input:11
	vec3 n_out11p0 = vec3(UV, 0.0);

// Input:10
	float n_out10p0 = TIME;

// ScalarUniform:14
	float n_out14p0 = wave_speed;

// ScalarOp:13
	float n_out13p0 = n_out10p0 * n_out14p0;

// VectorOp:12
	vec3 n_out12p0 = n_out11p0 + vec3(n_out13p0);

// ScalarUniform:22
	float n_out22p0 = wave_size;

// ScalarFunc:21
	float n_out21p0 = 1.0 - n_out22p0;

// ScalarOp:19
	float n_in19p1 = 1.00000;
	float n_out19p0 = n_out21p0 + n_in19p1;

// VectorOp:20
	vec3 n_out20p0 = n_out12p0 * vec3(n_out19p0);

// Texture:4
	vec4 tex_frg_4_read = texture(tex_frg_4, n_out20p0.xy);
	vec3 n_out4p0 = tex_frg_4_read.rgb;
	float n_out4p1 = tex_frg_4_read.a;

// ScalarUniform:8
	float n_out8p0 = wave_strenght;

// ScalarOp:6
	float n_out6p0 = dot(n_out4p0, vec3(0.333333, 0.333333, 0.333333)) * n_out8p0;

// ScalarOp:9
	float n_in9p1 = -0.50000;
	float n_out9p0 = n_out8p0 * n_in9p1;

// ScalarOp:7
	float n_out7p0 = n_out6p0 + n_out9p0;

// VectorOp:5
	vec3 n_out5p0 = n_out2p0 + vec3(n_out7p0);

// TextureUniform:3
	vec3 n_out3p0;
	float n_out3p1;
	{
		vec4 n_tex_read = texture(TextureUniform, n_out5p0.xy);
		n_out3p0 = n_tex_read.rgb;
		n_out3p1 = n_tex_read.a;
	}

// VectorOp:15
	vec3 n_out15p0 = n_out16p0 * n_out3p0;

// Input:18
	float n_out18p0 = MODULATE.a;

// ScalarOp:17
	float n_out17p0 = n_out3p1 * n_out18p0;

// Output:0
	COLOR.rgb = n_out15p0;
	COLOR.a = n_out17p0;

}

void light() {
// Output:0

}
