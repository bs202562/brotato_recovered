[resource]
code = "shader_type canvas_item;
uniform vec4 new_color : hint_color = vec4(0.105882, 1.000000, 0.176471, 1.000000);
uniform float detection_offset : hint_range(-1, 1) = 0.88;
uniform float detection_strenght : hint_range(0, 25) = 1;
uniform vec4 color_to_replace : hint_color = vec4(0.105882, 1.000000, 0.176471, 1.000000);



void vertex() {
// Output:0

}

void fragment() {
// Input:4
	vec3 n_out4p0 = MODULATE.rgb;

// ColorUniform:15
	vec3 n_out15p0 = new_color.rgb;
	float n_out15p1 = new_color.a;

// ScalarUniform:13
	float n_out13p0 = detection_offset;

// ScalarUniform:12
	float n_out12p0 = detection_strenght;

// ColorUniform:9
	vec3 n_out9p0 = color_to_replace.rgb;
	float n_out9p1 = color_to_replace.a;

// Input:2

// Texture:3
	vec3 n_out3p0;
	float n_out3p1;
	{
		vec4 TEXTURE_tex_read = texture(TEXTURE, UV.xy);
		n_out3p0 = TEXTURE_tex_read.rgb;
		n_out3p1 = TEXTURE_tex_read.a;
	}

// Distance:8
	float n_out8p0 = distance(n_out9p0, n_out3p0);

// ScalarOp:10
	float n_out10p0 = n_out12p0 * n_out8p0;

// ScalarOp:11
	float n_out11p0 = n_out13p0 + n_out10p0;

// ScalarClamp:14
	float n_in14p1 = 0.00000;
	float n_in14p2 = 1.00000;
	float n_out14p0 = clamp(n_out11p0, n_in14p1, n_in14p2);

// ScalarFunc:17
	float n_out17p0 = 1.0 - n_out14p0;

// ColorFunc:21
	vec3 n_out21p0;
	{
		vec3 c = n_out3p0;
		float max1 = max(c.r, c.g);
		float max2 = max(max1, c.b);
		n_out21p0 = vec3(max2, max2, max2);
	}

// VectorOp:22
	vec3 n_out22p0 = vec3(n_out17p0) * n_out21p0;

// VectorOp:18
	vec3 n_out18p0 = n_out15p0 * n_out22p0;

// VectorOp:16
	vec3 n_out16p0 = vec3(n_out14p0) * n_out3p0;

// VectorOp:19
	vec3 n_out19p0 = n_out18p0 + n_out16p0;

// VectorOp:5
	vec3 n_out5p0 = n_out4p0 * n_out19p0;

// Input:7
	float n_out7p0 = MODULATE.a;

// ScalarOp:6
	float n_out6p0 = n_out3p1 * n_out7p0;

// Output:0
	COLOR.rgb = n_out5p0;
	COLOR.a = n_out6p0;

}

void light() {
// Output:0

}
