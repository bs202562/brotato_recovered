[gd_resource type="Shader" format=3]

[resource]
code = "shader_type canvas_item;
render_mode blend_add;

// 4.x 移植: 原为 VisualShader,依赖 3.6 的 MODULATE 输入与图内嵌 NoiseTexture,
// 4.x 均不支持(MODULATE 输入不存在导致编译失败)。按资源内保存的 3.x 生成代码
// 改写为文本着色器:MODULATE 用片段入口的 COLOR(顶点色已含 modulate)代替,
// 噪声贴图(FastNoiseLite period=105.6, persistence=0.677, 512px seamless)
// 用同参数的程序化 value noise 代替。uniform 名与取值保持不变。

uniform float wave_speed = 1.0;
uniform float wave_size = 1.0;
uniform float wave_strenght = 0.1;
uniform sampler2D TextureUniform;

float vn_hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float value_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(
		mix(vn_hash(i), vn_hash(i + vec2(1.0, 0.0)), u.x),
		mix(vn_hash(i + vec2(0.0, 1.0)), vn_hash(i + vec2(1.0, 1.0)), u.x), u.y);
}

// FastNoiseLite 默认 3 个八度,persistence 0.677(权重归一化)
float fbm(vec2 p) {
	return value_noise(p) * 0.468
		+ value_noise(p * 2.0) * 0.317
		+ value_noise(p * 4.0) * 0.215;
}

void fragment() {
	vec3 modulate_rgb = COLOR.rgb;
	float modulate_a = COLOR.a;

	// 噪声采样 UV: (UV + TIME * wave_speed) * ((1.0 - wave_size) + 1.0)
	vec2 noise_uv = (UV + vec2(TIME * wave_speed)) * ((1.0 - wave_size) + 1.0);
	// 512px 贴图 / period 105.6 ≈ 每 UV 单位 4.85 个噪声周期
	float noise_gray = fbm(noise_uv * 4.85);

	float offset = noise_gray * wave_strenght + wave_strenght * -0.5;
	vec4 tex = texture(TextureUniform, UV + vec2(offset));

	COLOR.rgb = modulate_rgb * tex.rgb;
	COLOR.a = tex.a * modulate_a;
}
"
