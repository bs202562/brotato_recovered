[resource]
code = "shader_type canvas_item;
uniform float strenght : hint_range(0, 1) = 1;
uniform float uv_size = 10;
uniform float speed = 1;
uniform sampler2D tex_frg_2;



void vertex() {
// Output:0

}

void fragment() {
// Input:7
	float n_out7p0 = COLOR.a;

// ScalarUniform:14
	float n_out14p0 = strenght;

// Input:3
	vec3 n_out3p0 = vec3(UV, 0.0);

// ScalarUniform:10
	float n_out10p0 = uv_size;

// VectorOp:9
	vec3 n_out9p0 = n_out3p0 * vec3(n_out10p0);

// Input:5
	float n_out5p0 = TIME;

// ScalarUniform:11
	float n_out11p0 = speed;

// ScalarOp:12
	float n_out12p0 = n_out5p0 * n_out11p0;

// VectorOp:4
	vec3 n_out4p0 = n_out9p0 + vec3(n_out12p0);

// VectorOp:6
	vec3 n_in6p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out6p0 = mod(n_out4p0, n_in6p1);

// Texture:2
	vec4 tex_frg_2_read = texture(tex_frg_2, n_out6p0.xy);
	vec3 n_out2p0 = tex_frg_2_read.rgb;
	float n_out2p1 = tex_frg_2_read.a;

// ScalarOp:13
	float n_out13p0 = n_out14p0 * dot(n_out2p0, vec3(0.333333, 0.333333, 0.333333));

// ScalarOp:8
	float n_out8p0 = n_out7p0 * n_out13p0;

// Output:0
	COLOR.a = n_out8p0;

}

void light() {
// Output:0

}
